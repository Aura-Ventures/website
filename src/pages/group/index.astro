---
import type { MetaData } from '~/types';
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import invitationBg from '~/assets/images/fellowship/Invitationbg.png';

const metadata: MetaData = {
  title: 'Group Invitation',
  openGraph: {
    images: [
      {
        url: '~/assets/images/fellowship/bg.png',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <main class="invite" >
    <section class="invite-card" aria-label="Invitation" >
      <header class="invite-top">
        <div class="invite-from">
          <div class="invite-avatar" aria-hidden="true">
            <img id="fromAvatar" alt="" />
            <span id="fromInitials" class="invite-initials"></span>
          </div>
          <div class="invite-from-text">
            <span class="invite-from-label">From</span>
            <span id="fromName" class="invite-from-name"></span>
          </div>
          <Icon name="tabler:chevron-right" class="invite-chev" aria-hidden="true" />
        </div>

        <a class="invite-close" href="/" aria-label="Close invitation">
          <Icon name="tabler:x" class="invite-close-icon" aria-hidden="true" />
        </a>
      </header>

      <div class="invite-content" style={`background-image: url(${invitationBg.src});`}>
        <h1 class="invite-title">You have been invited</h1>
        <div class="invite-sub">
          <span id="subFromName"></span> invites you to join
        </div>
        <div id="groupName" class="invite-group"></div>

        <div class="invite-illustration" aria-hidden="true">
          <Image
            src="~/assets/images/fellowship/group.png"
            alt=""
            class="invite-ill-img"
            width={156.293}
            height={156.293}
            loading="lazy"
          />
        </div>

        <p class="invite-desc">
          This is an invitation to join a small group on Aura App. Please download or update your Aura App in order to join.
        </p>

        <div class="invite-btn-content">
          <a id="acceptLink" class="invite-btn" href="#">Accept Invitation</a>
        </div>

        <footer class="invite-brand" aria-label="Aura">
          <div class="invite-logo">Aura</div>
          <div class="invite-tagline">Pray Deeper | Walk Closer</div>
        </footer>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family:
      'Jost',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }

  :global(body.bg-page) {
    background: #e8e5de;
  }
  .invite{
    max-width: 600px;
    margin: 0 auto;
  }
  .invite-card {
    overflow: hidden;
    position: relative;
  }

  .invite-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 10px 14px;
    background: rgba(251, 250, 243, 0.65);
  }

  .invite-from {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .invite-avatar {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.08);
    overflow: hidden;
    position: relative;
    flex: none;
  }

  .invite-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .invite-initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.55);
  }

  .invite-from-text {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .invite-from-label {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.78);
    white-space: nowrap;
  }

  .invite-from-name {
    font-size: 14px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.92);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .invite-chev {
    width: 20px;
    height: 20px;
    color: rgba(0, 0, 0, 0.35);
  }

  .invite-close {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
  }

  .invite-close-icon {
    width: 16px;
    height: 16px;
  }

  .invite-content {
    padding: 26px 9px 22px 9px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .invite-title {
    width: 100%;
    font-family:
      'Lora',
      'LoraMedium',
      serif;
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: rgba(29, 18, 10, 0.96);
    margin-top: 35px;
    padding: 0 32px 16px 32px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .invite-sub {
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    color: rgba(60, 60, 67, 0.6);
  }

  .invite-group {
    margin-top: 4px;
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: normal;
    color: rgba(60, 60, 67, 0.6);
  }

  .invite-illustration {
    width: 100%;
  }

  .invite-ill-svg,
  .invite-ill-img {
    width: 156.293px;
    height: 156.293px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    display: block;
  }

  .invite-desc {
    margin-top: 31px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 16.768px;
    font-weight: 400;
    line-height: normal;
    color: #373737;
    max-width: 320px;
  }
  .invite-btn-content {
    margin-top: 31px;
    width: 100%;
    padding: 0 7px;
  }
  .invite-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.95);
    background: #f78376;
    font-family: 'NunitoSans', 'Nunito Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
      sans-serif;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .invite-btn:active {
    transform: translateY(1px);
  }

  .invite-brand {
    margin-top: 55px;
    width: 100%;
    padding: 0 16px;
    text-align: right;
  }

  .invite-logo {
    font-family: 'BeautiqueDisplayCondensed', serif;
    font-size: 23.055px;
    font-weight: 500;
    line-height: 29.343px;
    letter-spacing: 0.922px;
    text-transform: capitalize;
    text-align: right;
    color: #222222;
  }

  .invite-tagline {
    margin-top: 4px;
    text-align: right;
    font-family: 'Jost', sans-serif;
    font-size: 15.72px;
    font-weight: 400;
    line-height: 20.959px;
    color: #4f4f4f;
  }

</style>

<script>
  import { decodeShare } from '~/services';

  const urlParams = new URLSearchParams(window.location.search);
  const ticket = urlParams.get('ticket');

  const fetchData = async () => {
    if (!ticket) return;
    const data = await decodeShare(ticket as string);
    const avatarElement = document.getElementById('fromAvatar') as HTMLImageElement | null;
    const nameElement = document.getElementById('fromName');
    const subNameElement = document.getElementById('subFromName');
    const groupElement = document.getElementById('groupName');
    const acceptLinkElement = document.getElementById('acceptLink') as HTMLAnchorElement | null;

    if (avatarElement && data?.shareUser?.avatarUrl) {
      avatarElement.src = data.shareUser.avatarUrl;
      (avatarElement as HTMLImageElement).style.display = 'block';
    }

    if (nameElement && data?.shareUser?.fullName) {
      nameElement.textContent = data.shareUser.fullName;
    }

    if (subNameElement && data?.shareUser?.fullName) {
      subNameElement.textContent = data.shareUser.fullName;
    }

    const groupNameFromData = (data as any)?.data?.name;
    if (groupElement && groupNameFromData) {
      groupElement.textContent = String(groupNameFromData);
    }

    const fissionUrl = (data as any)?.data?.fissionUrl;
    if (acceptLinkElement && typeof fissionUrl === 'string' && fissionUrl.trim()) {
      acceptLinkElement.href = fissionUrl;
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    if (ticket) {
      fetchData();
    }
  });
</script>
