---
import type { MetaData } from '~/types';
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import invitationBg from '~/assets/images/fellowship/Invitationbg.png';

const metadata: MetaData = {
  title: 'Group Invitation',
  openGraph: {
    images: [
      {
        url: '~/assets/images/fellowship/bg.png',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <main class="invite" style={`background-image: url(${invitationBg.src});`}>
    <div class="invite__surface" role="presentation" aria-hidden="true"></div>

    <section class="invite__card" aria-label="Invitation">
      <header class="invite__top">
        <div class="invite__from">
          <div class="invite__avatar" aria-hidden="true">
            <img id="fromAvatar" alt="" />
            <span id="fromInitials" class="invite__initials">HC</span>
          </div>
          <div class="invite__fromText">
            <span class="invite__fromLabel">From</span>
            <span id="fromName" class="invite__fromName"></span>
          </div>
          <Icon name="tabler:chevron-right" class="invite__chev" aria-hidden="true" />
        </div>

        <a class="invite__close" href="/" aria-label="Close invitation">
          <Icon name="tabler:x" class="invite__closeIcon" aria-hidden="true" />
        </a>
      </header>

      <div class="invite__content">
        <h1 class="invite__title">Your have been invited</h1>
        <div class="invite__sub">
          <span id="subFromName"></span> invites you to join
        </div>
        <div id="groupName" class="invite__group"></div>

        <div class="invite__illustration" aria-hidden="true">
          <Image
            src="~/assets/images/fellowship/group.png"
            alt=""
            class="invite__illImg"
            width={156.293}
            height={156.293}
            loading="lazy"
          />
        </div>

        <p class="invite__desc">
          This is an invitation to join a small group on Aura App. Please download or update your Aura App in order to join.
        </p>

        <button id="acceptBtn" class="invite__btn" type="button">Accept Invitation</button>

        <footer class="invite__brand" aria-label="Aura">
          <div class="invite__logo">Aura</div>
          <div class="invite__tagline">Pray Deeper | Walk Closer</div>
        </footer>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family:
      'Jost',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }

  :global(body.bg-page) {
    background: #e8e5de;
  }

  .invite {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 14px;
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .invite__surface {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(320px 320px at 15% 25%, rgba(255, 198, 182, 0.75), rgba(255, 198, 182, 0) 65%),
      radial-gradient(360px 360px at 85% 30%, rgba(255, 213, 164, 0.75), rgba(255, 213, 164, 0) 62%),
      radial-gradient(420px 420px at 50% 65%, rgba(255, 205, 178, 0.5), rgba(255, 205, 178, 0) 70%);
    filter: blur(10px);
    pointer-events: none;
  }

  .invite__card {
    width: min(420px, 100%);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.08),
      0 6px 16px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(10px);
    overflow: hidden;
    position: relative;
  }

  .invite__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 10px 14px;
    background: rgba(251, 250, 243, 0.65);
  }

  .invite__from {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .invite__avatar {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.08);
    overflow: hidden;
    position: relative;
    flex: none;
  }

  .invite__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .invite__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.55);
  }

  .invite__fromText {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .invite__fromLabel {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.78);
    white-space: nowrap;
  }

  .invite__fromName {
    font-size: 14px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.92);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
  }

  .invite__chev {
    width: 20px;
    height: 20px;
    color: rgba(0, 0, 0, 0.35);
  }

  .invite__close {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
  }

  .invite__closeIcon {
    width: 16px;
    height: 16px;
  }

  .invite__content {
    padding: 26px 22px 22px 22px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .invite__title {
    font-family:
      'Lora',
      'LoraMedium',
      serif;
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: rgba(29, 18, 10, 0.96);
    margin: 0;
  }

  .invite__sub {
    margin-top: 10px;
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    color: rgba(60, 60, 67, 0.6);
  }

  .invite__group {
    margin-top: 4px;
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: normal;
    color: rgba(60, 60, 67, 0.6);
  }

  .invite__illustration {
    margin-top: 24px;
    width: 100%;
  }

  .invite__illSvg,
  .invite__illImg {
    width: 156.293px;
    height: 156.293px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    display: block;
  }

  .invite__desc {
    margin-top: 12px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    font-family: 'Jost', sans-serif;
    font-size: 16.768px;
    font-weight: 400;
    line-height: normal;
    color: #373737;
    max-width: 320px;
  }

  .invite__btn {
    margin-top: 16px;
    width: 100%;
    height: 52px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.95);
    background: #f78376;
    font-family: 'NunitoSans', 'Nunito Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
      sans-serif;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .invite__btn:active {
    transform: translateY(1px);
  }

  .invite__brand {
    margin-top: 22px;
    width: 100%;
    max-width: 340px;
    text-align: right;
  }

  .invite__logo {
    font-family: 'BeautiqueDisplayCondensed', serif;
    font-size: 23.055px;
    font-weight: 500;
    line-height: 29.343px;
    letter-spacing: 0.922px;
    text-transform: capitalize;
    text-align: right;
    color: #222222;
  }

  .invite__tagline {
    margin-top: 4px;
    text-align: right;
    font-family: 'Jost', sans-serif;
    font-size: 15.72px;
    font-weight: 400;
    line-height: 20.959px;
    color: #4f4f4f;
  }

  @media (max-width: 480px) {
    .invite {
      padding: 0;
    }
    .invite__card {
      width: 100%;
      min-height: 100svh;
      border-radius: 0;
      box-shadow: none;
      border: none;
      background: transparent;
      backdrop-filter: none;
    }
    .invite__top {
      padding: 16px 16px 8px 16px;
      background: transparent;
    }
    .invite__content {
      padding: 18px 20px 22px 20px;
    }
  }
</style>

<script>
  import { openApp } from '~/utils/applink';
  import { decodeShare } from '~/services';

  const urlParams = new URLSearchParams(window.location.search);
  const ticket = urlParams.get('ticket');

  const fetchData = async () => {
    if (!ticket) return;
    const data = await decodeShare(ticket as string);
    const avatarElement = document.getElementById('fromAvatar') as HTMLImageElement | null;
    const nameElement = document.getElementById('fromName');
    const subNameElement = document.getElementById('subFromName');
    const groupElement = document.getElementById('groupName');

    if (avatarElement && data?.shareUser?.avatarUrl) {
      avatarElement.src = data.shareUser.avatarUrl;
      (avatarElement as HTMLImageElement).style.display = 'block';
    }

    if (nameElement && data?.shareUser?.fullName) {
      nameElement.textContent = data.shareUser.fullName;
    }

    if (subNameElement && data?.shareUser?.fullName) {
      subNameElement.textContent = data.shareUser.fullName;
    }

    const groupNameFromData = (data as any)?.data?.name;
    if (groupElement && groupNameFromData) {
      groupElement.textContent = String(groupNameFromData);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    if (ticket) {
      fetchData();
    }

    const btn = document.getElementById('acceptBtn');
    btn?.addEventListener('click', () => {
      const searchParams = new URLSearchParams(window.location.search);
      const queryString = searchParams.toString();
      const path = queryString ? `group?${queryString}` : 'group';
      openApp(path);
    });
  });
</script>
